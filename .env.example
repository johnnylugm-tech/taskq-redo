# taskq-api environment variables (SPEC §5.1 — 12 TASKQ_* keys, each with a default)
# Copy to .env and edit values; do not commit .env.

# FR-06: SQLAlchemy connection string. SQLite (file) for dev/test, PostgreSQL for prod.
# NFR-04: the password inside this URL MUST NEVER be logged (strip before logging).
TASKQ_DB_URL=sqlite:///./taskq.db

# FR-06: SQLAlchemy connection pool size. pool_pre_ping=True is hard-coded.
TASKQ_DB_POOL_SIZE=5

# FR-08: per-task subprocess timeout (seconds). Must be > 0; sub-process must be
# killed on expiry (no orphan processes).
TASKQ_TASK_TIMEOUT=10.0

# FR-08: concurrent background tasks ceiling. New tasks queue, not spawn unlimited coroutines.
TASKQ_MAX_CONCURRENT=8

# FR-08: graceful drain budget on shutdown (seconds). After this, in-flight is interrupted.
TASKQ_DRAIN_TIMEOUT=30.0

# FR-05: token-bucket burst capacity.
TASKQ_RATE_BURST=20

# FR-05: token-bucket refill rate (tokens per second).
TASKQ_RATE_PER_SEC=5.0

# NFR-02: comma-separated CORS allow-list. Empty = reject all origins.
TASKQ_CORS_ORIGINS=

# Logging: DEBUG / INFO / WARNING / ERROR.
TASKQ_LOG_LEVEL=INFO

# Logging: json (machine-readable) or text (human).
TASKQ_LOG_FORMAT=json

# uvicorn bind address. Default does NOT expose to non-loopback.
TASKQ_HOST=127.0.0.1

# uvicorn bind port.
TASKQ_PORT=8000
